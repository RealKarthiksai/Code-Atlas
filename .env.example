# Google Gemini API Key
# Required for AI Overview, Diff Explainer, Repo Navigator, and Repo Agent.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional)
# Increases GitHub API rate limits from 60 requests/hr (unauthenticated) to 5,000 requests/hr.
# Useful for large repositories or frequent queries.
# Generate a token at: https://github.com/settings/tokens
GITHUB_TOKEN=
